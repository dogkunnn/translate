<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ICT / SMC Live Dub"
            android:textColor="#60A5FA"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="ดักฟังเสียง YouTube / Shorts / IG ในมือถือแล้วพากย์ไทยสดๆ (คงศัพท์ ICT/SMC)"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gemini API Key"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#131A2B"
            android:hint="AIzaSy..."
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#E2E8F0"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="System Instructions (คำสั่งล็อกศัพท์เทรด)"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPrompt"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="6dp"
            android:background="#131A2B"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#3B82F6"
            android:text="เริ่มแชร์เสียง &amp; พากย์ไทยสด"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#131A2B"
            android:padding="12dp"
            android:text="สถานะ: พร้อมใช้งาน (กดปุ่มด้านบน แล้วสลับไปเปิด YouTube / IG ได้เลย)"
            android:textColor="#34D399"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="คำแปลสด (Live Transcript)"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#131A2B"
            android:minHeight="160dp"
            android:padding="12dp"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
