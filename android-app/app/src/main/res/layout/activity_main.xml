<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B1A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nexsus"
                    android:textColor="#D8B4FE"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time Trading Dubbing • ICT / TTFM / GXT / VTrades"
                    android:textColor="#A78BFA"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLatencyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Delay: -- ms"
                android:textColor="#5EEAD4"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status & Action Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:text="สถานะ: พร้อมใช้งาน"
                android:textColor="#5EEAD4"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="#8B5CF6"
                    android:text="เริ่มแชร์เสียง &amp; พากย์ไทยสด"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMuteMain"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#241C40"
                    android:text="ปิดเสียง"
                    android:textColor="#E9D5FF"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="กดเริ่ม ➔ เลือก 'ทั้งหน้าจอ' ➔ สลับไปเปิด YouTube / IG ได้เลย"
                android:textColor="#A78BFA"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Permissions Helper Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ตั้งค่าสิทธิ์แนะนำ (ปุ่มลอย &amp; กันหลุด)"
                android:textColor="#F3E8FF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOverlayPerm"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#241C40"
                    android:text="ปุ่มลอยทับแอป"
                    android:textColor="#E9D5FF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBatteryPerm"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="#241C40"
                    android:text="ไม่จำกัดแบต"
                    android:textColor="#E9D5FF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Model, API Key & Trading Glossary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="โมเดล, API Key &amp; ศัพท์เทรด"
                    android:textColor="#F3E8FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnToggleSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#241C40"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="ย่อ/ขยาย"
                    android:textColor="#C4B5FD"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="เลือกโมเดล Gemini Live"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerModel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Gemini API Key"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="AIzaSy..."
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:textColor="#F3E8FF"
                    android:textColorHint="#6B5B95"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="คำสั่งล็อกศัพท์ (ICT / SMC / TTFM / GXT / VTrades)"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="#F3E8FF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Transcript Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="คำแปลสด (Live Transcript)"
                android:textColor="#F3E8FF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:minHeight="96dp"
                android:padding="10dp"
                android:textColor="#F3E8FF"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Collapsible & Copyable Debug Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Debug Log"
                    android:textColor="#F3E8FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyLog"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#241C40"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="คัดลอก Log"
                    android:textColor="#5EEAD4"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnToggleLog"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#241C40"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="ย่อ/ขยาย"
                    android:textColor="#C4B5FD"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="ยังไม่มี Log..."
                    android:textColor="#A78BFA"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
