<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Messenger-style circular bubble -->
    <LinearLayout
        android:id="@+id/bubbleHead"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBubbleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ICT"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expandable floating mini panel -->
    <LinearLayout
        android:id="@+id/bubblePanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFloatStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="กำลังทำงาน..."
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFloatTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="4"
            android:text="รอเสียงพูด..."
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFloatOpen"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:padding="0dp"
                android:text="เปิดแอป"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFloatStop"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#EF4444"
                android:padding="0dp"
                android:text="หยุดแปล"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
